--- a/src/styles.css
+++ b/src/styles.css
@@ -367,3 +367,47 @@
 @media (prefers-reduced-motion: reduce) {
   *, *::before, *::after { scroll-behavior: auto !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
 }
+
+
+.static-tarot-scene {
+  position: absolute;
+  z-index: 1;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  perspective: 1200px;
+  touch-action: none;
+  user-select: none;
+}
+.static-tarot-card {
+  position: relative;
+  height: min(82%, 390px);
+  aspect-ratio: 5 / 8;
+  transform-style: preserve-3d;
+  transition: transform 650ms cubic-bezier(.22,.68,.18,1);
+  border-radius: 12px;
+}
+.static-tarot-face {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  object-fit: contain;
+  border-radius: 12px;
+  backface-visibility: hidden;
+  -webkit-backface-visibility: hidden;
+  box-shadow: 0 14px 24px rgba(68,52,28,.2);
+  pointer-events: none;
+}
+.static-tarot-back { transform: rotateY(180deg); }
+.static-mode-note {
+  position: absolute;
+  bottom: 5px;
+  color: var(--ink-muted);
+  font-size: 10px;
+  text-align: center;
+  pointer-events: none;
+}
+@media (prefers-reduced-motion: reduce) {
+  .static-tarot-card { transition: none; }
+}
