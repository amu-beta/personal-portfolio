diff --git a/src/StaticTarotScene.jsx b/src/StaticTarotScene.jsx
new file mode 100644
--- /dev/null
+++ b/src/StaticTarotScene.jsx
@@ -0,0 +1,59 @@
+import React, { forwardRef, useEffect, useImperativeHandle, useRef, useState } from 'react';
+import backUrl from '../assets/tarot-proposals-2026-10-09/cards/shared-back.png';
+
+// Keep the complete card deck usable when a browser cannot create a WebGL2 context.
+const StaticTarotScene = forwardRef(function StaticTarotScene({ card, isBack, onTurn, onReady, onDragging }, ref) {
+  const pointer = useRef(null);
+  const [tilt, setTilt] = useState({ x: 0, y: 0 });
+
+  useImperativeHandle(ref, () => ({ reset: () => setTilt({ x: 0, y: 0 }) }), []);
+  useEffect(() => { onReady(); }, [card.id, onReady]);
+  useEffect(() => { setTilt({ x: 0, y: 0 }); }, [card.id]);
+
+  const finishPointer = (event) => {
+    const start = pointer.current;
+    if (!start) return;
+    pointer.current = null;
+    onDragging(false);
+    setTilt({ x: 0, y: 0 });
+    const dx = event.clientX - start.x;
+    const dy = event.clientY - start.y;
+    if (Math.abs(dx) > 32 || (Math.abs(dx) < 8 && Math.abs(dy) < 8)) onTurn(!isBack);
+    try { event.currentTarget.releasePointerCapture(event.pointerId); } catch {}
+  };
+
+  return (
+    <div className="static-tarot-scene"
+      onPointerDown={(event) => {
+        pointer.current = { x: event.clientX, y: event.clientY };
+        onDragging(true);
+        event.currentTarget.setPointerCapture(event.pointerId);
+      }}
+      onPointerMove={(event) => {
+        if (event.pointerType !== 'mouse') return;
+        const bounds = event.currentTarget.getBoundingClientRect();
+        setTilt({
+          x: (0.5 - (event.clientY - bounds.top) / bounds.height) * 12,
+          y: ((event.clientX - bounds.left) / bounds.width - 0.5) * 12,
+        });
+      }}
+      onPointerUp={finishPointer}
+      onPointerCancel={(event) => {
+        pointer.current = null;
+        onDragging(false);
+        setTilt({ x: 0, y: 0 });
+        try { event.currentTarget.releasePointerCapture(event.pointerId); } catch {}
+      }}
+      onPointerLeave={() => { if (!pointer.current) setTilt({ x: 0, y: 0 }); }}
+    >
+      <div className="static-tarot-card" role="img" aria-label={card.name + (isBack ? '塔罗牌牌背' : '塔罗牌正面')}
+        style={{ transform: `rotateX(${tilt.x}deg) rotateY(${(isBack ? 180 : 0) + tilt.y}deg)` }}>
+        <img className="static-tarot-face" src={card.frontUrl} alt="" draggable="false" />
+        <img className="static-tarot-face static-tarot-back" src={backUrl} alt="" draggable="false" />
+      </div>
+      <span className="static-mode-note">当前以图片模式展示 · 支持切牌与翻面</span>
+    </div>
+  );
+});
+
+export default StaticTarotScene;
